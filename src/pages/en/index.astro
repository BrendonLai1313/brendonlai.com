---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ConversionEntries from '../../components/ConversionEntries.astro';
import Facets from '../../components/Facets.astro';
import Milestones from '../../components/Milestones.astro';
import ProofPoints from '../../components/ProofPoints.astro';
import Contact from '../../components/Contact.astro';
import { siteJsonLd } from '../../data/schema';

const siteSchema = siteJsonLd('en');
---

<Layout
  title="Brendon Lai | One person × AI, helping Chinese industry land in Southeast Asia"
  description="Brendon Lai — one person × AI, helping Chinese industry land in Southeast Asia. Three proofs: a Southeast Asian industrial-supply company built from zero, cross-border compliance tools, and AI-made character-building cartoons."
  canonicalPath="/"
  mainClass=""
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </Fragment>
  <Hero />
  <ProofPoints />
  <ConversionEntries />
  <Facets />
  <Milestones />
  <Contact />
</Layout>
