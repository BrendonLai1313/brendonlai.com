---
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Milestones from '../../components/Milestones.astro';
import MatrixPreview from '../../components/MatrixPreview.astro';
import Contact from '../../components/Contact.astro';
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brendon Lai | Helping Chinese industry land in Southeast Asia</title>
    <link rel="alternate" hreflang="zh-CN" href="https://brendonlai.com/" />
    <link rel="alternate" hreflang="en" href="https://brendonlai.com/en/" />
    <link rel="canonical" href="https://brendonlai.com/en/" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style is:global>
        body {
            background-color: #FFFFFF;
            color: #333333;
            -webkit-font-smoothing: antialiased;
        }

        .timeline-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background-color: #D97757;
            border: 4px solid #FFFFFF;
            box-shadow: 0 0 0 2px #1E293B;
            transition: all 0.3s ease;
        }

        .hk-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -5px rgba(30, 41, 59, 0.1);
        }
    </style>
</head>
<body class="font-sans leading-relaxed selection:bg-hk-accent selection:text-white">
    <Header />
    <Hero />
    <Milestones />
    <MatrixPreview />
    <Contact />
</body>
</html>
