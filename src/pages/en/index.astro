---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ConversionEntries from '../../components/ConversionEntries.astro';
import Facets from '../../components/Facets.astro';
import Milestones from '../../components/Milestones.astro';
import MatrixPreview from '../../components/MatrixPreview.astro';
import Contact from '../../components/Contact.astro';
import { siteJsonLd } from '../../data/schema';

const siteSchema = siteJsonLd('en');
---

<Layout
  title="Brendon Lai | Helping Chinese industry land in Southeast Asia"
  description="Brendon Lai — a hands-on advisor helping Chinese industry land in Southeast Asia: market entry, channel building and local distribution."
  canonicalPath="/"
  mainClass=""
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </Fragment>
  <Hero />
  <ConversionEntries />
  <Facets />
  <Milestones />
  <MatrixPreview />
  <Contact />
</Layout>
