---
import Header from '../../../components/Header.astro';
import '../../../styles/global.css';

const wordpressUrl = import.meta.env.PUBLIC_WORDPRESS_URL || 'https://blog.brendonlai.com';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Insights - Brendon Lai</title>
    <link rel="alternate" hreflang="zh-CN" href="https://brendonlai.com/insights" />
    <link rel="alternate" hreflang="en" href="https://brendonlai.com/en/insights" />
    <link rel="canonical" href="https://brendonlai.com/en/insights" />
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen flex flex-col overflow-hidden">
    <Header />

    <main class="flex-grow pt-[72px] h-screen">
      <iframe
        src={wordpressUrl}
        class="w-full h-full border-none"
        title="Brendon Insights"
        loading="eager"
      ></iframe>
    </main>

  </body>
</html>
