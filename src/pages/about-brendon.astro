---
import Layout from '../layouts/Layout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="关于 Brendon | 三幕人生故事"
  description="我是 Brendon Lai —— 爸爸、丈夫、企业顾问。这一页不是简历，而是我如何从现实走出来、再走向自己选择的人生版本的三幕故事。"
  canonicalPath="/about-brendon"
>
  <section class="px-6 max-w-6xl mx-auto pb-16">
    <p class="text-xs font-bold tracking-[0.28em] text-hk-accent mb-5">ABOUT BRENDON</p>
    <h1 class="text-4xl md:text-5xl font-black text-hk-primary leading-tight mb-6">
      Life isn't about finding your place — it's choosing who you want to be.
    </h1>
    <p class="text-stone-600 max-w-3xl text-lg mb-8">
      我是 Brendon Lai，一位爸爸、一位丈夫、也是一位企业顾问。这一页不是简历，而是我如何从现实中走出来，再走向自己选择人生版本的三幕故事。
    </p>
    <a
      href="#journey-timeline"
      class="inline-flex items-center gap-2 px-6 py-3 bg-stone-900 text-white rounded-full text-sm font-bold hover:bg-amber-600 transition-colors shadow-lg"
    >
      <i class="fas fa-route"></i> 查看打怪升级明细路线图
    </a>
  </section>

  <JourneyTimeline />
  <Contact />
</Layout>
