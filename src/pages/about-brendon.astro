---
import Header from '../components/Header.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';

const aboutImages = {
    origin: '/hero-life.jpg',
    career: '/hero-work.jpg',
    growth: '/hero-main.jpg'
};
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>关于 Brendon | 三幕人生故事</title>
    <link rel="alternate" hreflang="zh-CN" href="https://brendonlai.com/about-brendon" />
    <link rel="alternate" hreflang="en" href="https://brendonlai.com/en/about-brendon" />
    <link rel="canonical" href="https://brendonlai.com/about-brendon" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="font-sans leading-relaxed selection:bg-hk-accent selection:text-white bg-white text-hk-text">
    <Header />
    <main class="pt-28">
        <section class="px-6 max-w-6xl mx-auto pb-16">
            <p class="text-xs font-bold tracking-[0.28em] text-hk-accent mb-5">ABOUT BRENDON</p>
            <h1 class="text-4xl md:text-5xl font-black text-hk-primary leading-tight mb-6">Life isn't about finding your place — it's choosing who you want to be.</h1>
            <p class="text-stone-600 max-w-3xl text-lg mb-8">
                我是 Brendon Lai，一位爸爸、一位丈夫、也是一位企业顾问。这一页不是简历，而是我如何从现实中走出来，再走向自己选择人生版本的三幕故事。
            </p>
            <a href="#journey-timeline" class="inline-flex items-center gap-2 px-6 py-3 bg-stone-900 text-white rounded-full text-sm font-bold hover:bg-amber-600 transition-colors shadow-lg">
                <i class="fas fa-route"></i> 查看打怪升级明细路线图
            </a>
        </section>

        <JourneyTimeline />
    </main>
    <Contact />
</body>
</html>
