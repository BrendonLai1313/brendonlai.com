---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ConversionEntries from '../components/ConversionEntries.astro';
import Facets from '../components/Facets.astro';
import Milestones from '../components/Milestones.astro';
import ProofPoints from '../components/ProofPoints.astro';
import Contact from '../components/Contact.astro';
import { siteJsonLd } from '../data/schema';

const siteSchema = siteJsonLd('zh');
---

<Layout
  title="Brendon Lai | 一个人 × AI，帮中国工业落地东南亚"
  description="Brendon Lai —— 一个人 × AI，帮中国工业落地东南亚。三个实证：东南亚工业品公司从 0 搭建、跨境出海合规工具、与孩子用 AI 拍品格动画。"
  canonicalPath="/"
  mainClass=""
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </Fragment>
  <Hero />
  <ProofPoints />
  <ConversionEntries />
  <Facets />
  <Milestones />
  <Contact />
</Layout>
