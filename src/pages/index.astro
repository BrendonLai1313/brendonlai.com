---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ConversionEntries from '../components/ConversionEntries.astro';
import Facets from '../components/Facets.astro';
import Milestones from '../components/Milestones.astro';
import MatrixPreview from '../components/MatrixPreview.astro';
import Contact from '../components/Contact.astro';
import { siteJsonLd } from '../data/schema';

const siteSchema = siteJsonLd('zh');
---

<Layout
  title="Brendon Lai | 帮中国工业落地东南亚的实战顾问 · 打怪升级之路"
  description="赖先生 —— 帮中国工业落地东南亚的实战顾问。这里是我一人的内容枢纽：工业出海、AI 自动化与一人公司运营的实战输出。"
  canonicalPath="/"
  mainClass=""
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </Fragment>
  <Hero />
  <ConversionEntries />
  <Facets />
  <Milestones />
  <MatrixPreview />
  <Contact />
</Layout>
