---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';

const isEn = Astro.currentLocale === 'en';

const books = await getCollection('books');

const cabinets = isEn
  ? [
      { id: 'corporate', title: 'Brand campaigns', meta: 'Work made inside companies: brand ads & team training · proof of work', icon: 'fa-briefcase' },
      { id: 'published', title: 'Published content', meta: 'Articles & posts · refined thinking', icon: 'fa-feather' },
      { id: 'future', title: 'Personal IP · Future', meta: 'Upcoming personal IP videos · the main battlefield', icon: 'fa-clapperboard' },
      { id: 'methodology', title: 'Methodology', meta: 'Reusable SOPs & checklists · playbooks', icon: 'fa-book' },
    ]
  : [
      { id: 'corporate', title: '品牌实战', meta: '过往在企业里做的作品：品牌广告与团队培训 · 专业背书', icon: 'fa-briefcase' },
      { id: 'published', title: '内容输出', meta: '已发布文章 / 帖子 · 沉淀思考', icon: 'fa-feather' },
      { id: 'future', title: '个人 IP · 未来', meta: '未来的个人 IP 视频 · 持续更新的主战场', icon: 'fa-clapperboard' },
      { id: 'methodology', title: '方法论手册', meta: '反复使用的 SOP / 清单 · 干货', icon: 'fa-book' },
    ];

const typeLabel = isEn
  ? { video: 'Video', article: 'Article', short: 'Short' }
  : { video: '视频', article: '文章', short: '短文' };

function formatDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}

function booksOf(cabinetId: (typeof cabinets)[number]['id']) {
  return books
    .filter((b) => b.data.cabinet === cabinetId)
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
}

// 根据语言取标题 / 摘要 / 关键词
function title(b: any) { return isEn ? (b.data.titleEn || b.data.title) : b.data.title; }
function summary(b: any) { return isEn ? (b.data.summaryEn || b.data.summary) : b.data.summary; }
function keywords(b: any) { return isEn ? (b.data.keywordsEn || b.data.keywords) : b.data.keywords; }

const pageTitle = isEn
  ? 'Brendon Hub | Field notes from a one-person company'
  : 'Brendon Hub | 有料放送 · 一人公司运营实录';
const pageDesc = isEn
  ? "Brendon Lai's content hub: field notes on industrial expansion, AI automation and one-person-company operations."
  : 'Brendon Lai 的内容枢纽：持续输出关于工业出海、AI 自动化与一人公司运营的实战干货。';
const h1 = isEn ? 'Field Notes' : '有料放送';
const h1Sub = isEn
  ? 'The one-person-company operations log · high-value content on industrial expansion, AI automation and entrepreneurship.'
  : '一人公司运营实录 · 持续输出工业出海、AI 自动化与创业实战的高价值内容。';
const eyebrow = 'BRENDON HUB';
---

<Layout title={pageTitle} description={pageDesc} canonicalPath="/hub" mainClass="pt-28 pb-16">
  <section class="px-6 max-w-6xl mx-auto pb-14">
    <p class="text-xs font-bold tracking-[0.28em] text-hk-accent mb-4">{eyebrow}</p>
    <h1 class="text-4xl md:text-5xl font-black text-hk-primary leading-tight">{h1}</h1>
    <p class="text-stone-500 mt-3 max-w-2xl text-lg">{h1Sub}</p>
  </section>

  {cabinets.map((cabinet) => {
    const items = booksOf(cabinet.id);
    if (items.length === 0) return null;
    return (
      <section class="px-6 max-w-6xl mx-auto pb-14">
        <div class="flex items-center gap-3 mb-6">
          <i class={`fas ${cabinet.icon} text-hk-accent`}></i>
          <h2 class="text-2xl font-black text-hk-primary">{cabinet.title}</h2>
          <span class="text-stone-400 text-sm">{cabinet.meta}</span>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {items.map((book) => (
            <article class="group bg-white border border-stone-200 rounded-2xl p-6 hover:border-hk-accent/50 hover:-translate-y-1 transition duration-300 shadow-sm flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 bg-stone-100 text-stone-600 text-xs font-bold rounded-full">{typeLabel[book.data.type]}</span>
                <time datetime={book.data.publishedAt.toISOString()} class="text-xs text-stone-400 font-mono">{formatDate(book.data.publishedAt)}</time>
              </div>
              <h3 class="text-lg font-bold text-hk-primary leading-snug">
                <a href={`${isEn ? '/en' : ''}/hub/${book.id}`} class="hover:text-hk-accent transition">{title(book)}</a>
              </h3>
              <p class="text-sm text-stone-600 leading-relaxed flex-1">{summary(book)}</p>
              <div class="flex flex-wrap gap-2 pt-1">
                {keywords(book).map((k) => (
                  <span class="text-xs text-hk-accent">{k}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  <Contact />
</Layout>
