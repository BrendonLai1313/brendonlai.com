---
import Layout from '../layouts/Layout.astro';
import Lab from '../components/Lab.astro';
import Contact from '../components/Contact.astro';
import CaseFile from '../components/CaseFile.astro';
import { CASE_FILES } from '../data/projects';

// 商业/逻辑用途: 硬核阵地与冰山防御策略落地页
// 采用复古档案柜 (Retro File Cabinet) 布局，展示深层系统架构与代码，并用表单锁定核心资源

// 案例资料见 src/data/projects.ts；档案卡外壳见 CaseFile.astro（解锁 CTA 的 FORMS 回退逻辑在元件内）。
---

<Layout
  title="矩阵档案柜 | Brendon Lai 的硬核阵地"
  description="系统级思维的幕后解剖：跨境贸易 AI 引擎、Google Workspace 迁移与生物效率 SOP 的实战拆解，水面之下是代码与资源。"
  canonicalPath="/projects"
  bodyClass="file-cabinet-bg text-hk-text"
  mainClass="pt-32 pb-20 px-6 max-w-5xl mx-auto min-h-screen"
>
  <Fragment slot="head">
    <style is:global>
      body {
        background-color: #Fdfbf7; /* 老香港暖石色底 */
        color: #333333;
        -webkit-font-smoothing: antialiased;
      }

      /* 复古档案柜纹理 */
      .file-cabinet-bg {
        background-image:
          linear-gradient(rgba(217, 119, 87, 0.05) 2px, transparent 2px),
          linear-gradient(90deg, rgba(217, 119, 87, 0.05) 2px, transparent 2px);
        background-size: 40px 40px;
      }
    </style>
  </Fragment>

  <!-- 页面头部 (Page Header) -->
  <div class="mb-16 border-b-4 border-stone-800 pb-8 relative">
    <div class="absolute -top-4 right-0 opacity-10">
      <i class="fas fa-folder-open text-9xl text-hk-accent"></i>
    </div>
    <h1 class="text-4xl md:text-6xl font-black text-stone-900 tracking-tight font-mono">
      <span class="text-hk-accent">#</span> 矩阵档案柜
    </h1>
    <p class="text-xl text-stone-500 mt-4 font-medium max-w-2xl">
      系统级思维的幕后解剖。水面之上是架构与逻辑，水面之下是代码与资源。
    </p>
  </div>

  <Lab />

  <!-- 看板/档案柜列表 (Kanban/File Cabinet Layout) -->
  <div class="space-y-12">
    {CASE_FILES.map((c) => <CaseFile data={c} />)}
  </div>

  <Contact />
</Layout>
