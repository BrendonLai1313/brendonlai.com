---
// 首页「三个实证」区块（改版路线图第 2 步）
// -----------------------------------------------------------------------------
// 资料全部来自 src/data/proofs.ts；出口网址由 site.ts 解析。
// 设计意图：实证讲「做过什么、结果怎样」，链接刻意低调（灰色小字），
// 与下方 ConversionEntries（#conversion，橙色 CTA）区分开来。
// -----------------------------------------------------------------------------
import { PROOFS, PROOFS_COPY } from '../data/proofs';

const lang = Astro.currentLocale === 'en' ? 'en' : 'zh';
const t = PROOFS_COPY[lang];
---

<section id="proof" class="scroll-mt-28 py-20 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-xs font-bold tracking-[0.28em] text-hk-accent mb-4">{t.eyebrow}</p>
      <h2 class="text-3xl md:text-4xl font-black text-hk-primary mb-4">{t.h2}</h2>
      <p class="text-stone-500 max-w-2xl mx-auto leading-relaxed">{t.sub}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {
        PROOFS.map((p) => (
          <article class="relative bg-white rounded-2xl border border-stone-200 p-7 shadow-sm flex flex-col">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold tracking-widest text-stone-500">{p.tag[lang]}</span>
              <span class="w-10 h-10 rounded-xl bg-hk-accent/10 text-hk-accent flex items-center justify-center">
                <i class={`fas ${p.icon}`} aria-hidden="true" />
              </span>
            </div>

            <p class="text-sm text-stone-500 leading-relaxed border-l-2 border-hk-accent/40 pl-3 mb-4">
              {p.question[lang]}
            </p>

            <h3 class="text-xl font-black text-hk-primary leading-snug mb-4">{p.title[lang]}</h3>

            <p class="text-sm font-semibold text-hk-primary bg-stone-50 rounded-lg px-3 py-2.5 leading-relaxed mb-5">
              <i class="fas fa-check text-hk-accent mr-1.5" aria-hidden="true" />
              {p.result[lang]}
            </p>

            <div class="mb-6">
              <p class="text-[11px] font-bold tracking-[0.2em] text-stone-400 mb-2">{t.rolesLabel}</p>
              <ul class="flex flex-wrap gap-1.5">
                {p.roles[lang].map((r) => (
                  <li class="text-xs text-stone-600 border border-stone-200 rounded-md px-2 py-0.5">{r}</li>
                ))}
              </ul>
            </div>

            {p.link.href && (
              <a
                href={p.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-flex items-center gap-1.5 text-sm text-stone-500 hover:text-hk-accent transition"
              >
                {p.link.label[lang]}
                <i class="fas fa-arrow-up-right-from-square text-[10px]" aria-hidden="true" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
