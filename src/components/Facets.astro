            <div class="grid grid-cols-3 lg:grid-cols-1 gap-4">
                <div class="bg-white p-6 rounded-2xl border border-stone-100 shadow-sm text-center lg:text-left">
                    <div class="text-3xl font-black text-hk-primary">1500+</div>
                    <p class="text-xs tracking-[0.2em] text-stone-500 mt-2">客户满意服务</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-stone-100 shadow-sm text-center lg:text-left">
                    <div class="text-3xl font-black text-hk-primary">5</div>
                    <p class="text-xs tracking-[0.2em] text-stone-500 mt-2">不同国家工作经验</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-stone-100 shadow-sm text-center lg:text-left">
                    <div class="text-3xl font-black text-hk-primary">15</div>
                    <p class="text-xs tracking-[0.2em] text-stone-500 mt-2">Years of experience</p>
                </div>
            </div>
        </div>
    </div>
