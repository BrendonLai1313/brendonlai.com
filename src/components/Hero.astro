---
import { SOCIAL } from '../data/site';

const lang = Astro.currentLocale === 'en' ? 'en' : 'zh';
const isEn = lang === 'en';

// 2026-11-03 Hero：主张改为「AI 驱动的精干团队，帮中国工业落地东南亚」（不再强调一人公司）。
// 三张翻卡 = 实证 A / 实证 B / 本人，不再放小朋友的相（私隐规则，见 docs/DECISIONS.md）。
const t = isEn
  ? {
      badge: 'Stay true. Serve the industry.',
      h1a: 'An AI-driven lean team,',
      h1b: 'helping Chinese industry land in Southeast Asia',
      tag1: '[ 20+ years on the industrial sales front line ]',
      tag2: '[ Method: traditional workflows × AI efficiency ]',
      tag3: '[ Focus: Chinese industry → Southeast Asia ]',
      p1: "20+ years in industrial sales and management — Japanese component makers, a European catalog distributor, a Chinese supply-chain platform, a German tool brand. Today we put AI to work on the most 'traditional' parts of a manufacturer's business — product selection, quoting, compliance documents, delivery follow-up — so the same workflow runs faster, more accurately and with fewer errors.",
      p2: 'Speed goes to AI; judgement stays with people. Here are three proofs you can check — and the mistakes we paid to learn from.',
      cta1: 'See how I can help',
      cta2: 'See the three proofs →',
      cta3: 'Who is Brendon',
    }
  : {
      badge: '坚守真实，贡献产业',
      h1a: 'AI 驱动的精干团队，',
      h1b: '帮中国工业落地东南亚',
      tag1: '[ 20+ 年工业销售一线 ]',
      tag2: '[ 方法：传统流程 × AI 提效 ]',
      tag3: '[ 方向：中国工业 → 东南亚 ]',
      p1: '20 多年工业品销售与管理：日系元器件原厂、欧洲目录分销、中国供应链平台、德国工具品牌。今天，我们把 AI 用在制造企业最「传统」的环节——选型、报价、合规文件、交付跟进——让同一套流程更快、更准、更少出错。',
      p2: '速度交给 AI，判断留给人。这里有三个可以核查的实证，也有我们交过学费的坑。',
      cta1: '了解我能帮你做什么',
      cta2: '看三个实证 →',
      cta3: 'Brendon是谁',
    };

// 三张翻卡：正面相片，背面一句话。中间那张是主角（本人）。
const cards = [
  {
    src: '/photos/case-a-workbench.jpg',
    alt: isEn ? 'Brendon assembling a workbench on site' : 'Brendon 在交付现场组装工作台',
    pos: 'object-[70%_50%]',
    label: isEn ? 'PROOF A' : 'PROOF A',
    back: isEn
      ? 'A Southeast Asian company from 0→1 — from building the systems to on-site delivery, I take part at every step.'
      : '东南亚 0→1：从系统搭建到现场交付，每一步我都亲身参与。',
    side: 'left',
  },
  {
    src: '/photos/hero-shanghai-industry40.jpg',
    alt: isEn
      ? 'Brendon Lai speaking for GAI at the Asia Industry 4.0 Automation Conference, Shanghai, 2026'
      : 'Brendon Lai 代表 GAI 在 2026 年上海「亚洲工业4.0自动化交流会」演讲',
    pos: 'object-[20%_50%]',
    label: 'ON STAGE',
    back: isEn
      ? 'Speaking for GAI at the Asia Industry 4.0 Automation Conference in Shanghai: how AI gets put to work for manufacturers.'
      : '代表 GAI 在上海「亚洲工业4.0自动化交流会」分享：AI 如何落地服务生产企业。',
    side: 'center',
  },
  {
    src: '/photos/case-b-client-site.jpg',
    alt: isEn ? 'At a client site for the SDS tool' : 'SDS 工具的客户现场',
    pos: 'object-[65%_50%]',
    label: 'PROOF B',
    back: isEn
      ? 'Compliance paperwork turned into tools — the SDS generator now has a paying customer.'
      : '把合规文件做成工具：SDS 生成工具已有付费客户。',
    side: 'right',
  },
];

const SIDE = {
  left: 'w-36 h-52 sm:w-40 sm:h-56 lg:w-44 lg:h-60 [perspective:1200px] transition-all duration-500 ease-out [transform:rotateY(14deg)_translateY(14px)] opacity-85 group-hover/covers:opacity-50 group-hover/covers:scale-95 hover:!opacity-100 hover:!scale-[1.08] hover:!translate-y-[-12px] hover:![transform:rotateY(0deg)] hover:!z-30',
  center: 'w-36 h-52 sm:w-40 sm:h-56 lg:w-44 lg:h-60 [perspective:1200px] transition-all duration-500 ease-out [transform:translateY(-8px)] z-20 group-hover/covers:opacity-50 group-hover/covers:scale-95 hover:!opacity-100 hover:!scale-[1.08] hover:!translate-y-[-14px] hover:!z-30',
  right: 'w-36 h-52 sm:w-40 sm:h-56 lg:w-44 lg:h-60 [perspective:1200px] transition-all duration-500 ease-out [transform:rotateY(-14deg)_translateY(14px)] opacity-85 group-hover/covers:opacity-50 group-hover/covers:scale-95 hover:!opacity-100 hover:!scale-[1.08] hover:!translate-y-[-12px] hover:!z-30 hover:![transform:rotateY(0deg)]',
} as const;
---

<section id="hero" class="pt-32 pb-20 px-6 max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12 min-h-[80vh]">
    <div class="w-full md:w-1/2 space-y-8">
        <div class="inline-block px-3 py-1 border border-hk-accent/30 text-hk-accent text-sm font-bold rounded-full bg-hk-accent/5">
            {t.badge}
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-hk-primary leading-[1.2]">
            {t.h1a}<br/>
            <span class="text-hk-accent relative inline-block mt-2">
                {t.h1b}
                <svg class="absolute w-full h-3 -bottom-1 left-0 text-hk-accent/20" viewBox="0 0 100 10" preserveAspectRatio="none">
                    <path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="4" fill="transparent"/>
                </svg>
            </span>
        </h1>

        <!-- 商业/逻辑用途: 核心定位标签 (老香港霓虹灯牌质感) -->
        <div class="flex flex-wrap gap-3 pt-2 pb-2">
            <span class="border border-amber-600 text-amber-700 bg-amber-50 px-3 py-1 rounded-md text-sm font-medium">{t.tag1}</span>
            <span class="border border-amber-600 text-amber-700 bg-amber-50 px-3 py-1 rounded-md text-sm font-medium">{t.tag2}</span>
            <span class="border border-amber-600 text-amber-700 bg-amber-50 px-3 py-1 rounded-md text-sm font-medium">{t.tag3}</span>
        </div>

        <p class="text-lg text-stone-600 leading-relaxed font-medium">
            {t.p1}
        </p>
        <p class="text-stone-500 leading-relaxed">
            {t.p2}
        </p>
        <div class="pt-4 flex flex-wrap gap-4">
            <a href="#conversion" class="px-8 py-3 bg-hk-primary text-white rounded-md shadow-lg hover:bg-slate-700 transition font-medium">
                {t.cta1}
            </a>
            <a href="#proof" class="bg-amber-600 text-white px-8 py-3 rounded-full hover:bg-amber-700 transition shadow-md font-medium">
                {t.cta2}
            </a>
            {/* R2：改為連結到 ABOUT BRENDON 頁 */}
            <a href={isEn ? '/en/about-brendon' : '/about-brendon'} class="inline-flex items-center gap-2 px-5 py-3 text-hk-primary/60 hover:text-hk-accent transition font-medium">
                {t.cta3}
                <i class="fas fa-arrow-right text-xs"></i>
            </a>
            {/* R6：領英按鈕取代原本的圖示 */}
            {SOCIAL.linkedin && (
                <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 border border-stone-300 text-hk-primary hover:border-hk-accent hover:text-hk-accent rounded-full transition font-medium">
                    <i class="fab fa-linkedin text-[#0077b5]"></i>
                    {isEn ? 'My LinkedIn' : '我的领英'}
                </a>
            )}
        </div>
    </div>
    <div class="w-full md:w-1/2 relative md:pl-6">
        <div class="relative h-[420px] sm:h-[460px] lg:h-[500px] flex items-center justify-center">
            <div class="absolute inset-10 rounded-3xl bg-hk-accent/10 blur-2xl"></div>
            <div class="relative z-10 w-full max-w-[560px] group/covers [perspective:1500px]">
                <div class="flex items-center justify-center gap-3 sm:gap-5">
                    {cards.map((c) => (
                        <div class={SIDE[c.side as keyof typeof SIDE]}>
                            <div class="flip-card-inner relative w-full h-full [transform-style:preserve-3d] transition-transform duration-700 delay-100 hover:[transform:rotateY(180deg)]">
                                <div class="absolute inset-0 rounded-2xl overflow-hidden border-4 border-white shadow-xl [backface-visibility:hidden]">
                                    <img
                                        src={c.src}
                                        alt={c.alt}
                                        class={`w-full h-full object-cover ${c.pos}`}
                                        loading={c.side === 'center' ? 'eager' : 'lazy'}
                                        decoding="async"
                                    />
                                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-900/75 to-transparent p-3">
                                        <p class="text-xs tracking-[0.2em] text-white/95">{c.label}</p>
                                    </div>
                                </div>
                                <div class="absolute inset-0 rounded-2xl border-4 border-white bg-slate-900 text-white shadow-xl p-5 flex flex-col justify-end [transform:rotateY(180deg)] [backface-visibility:hidden]">
                                    <p class="text-xs tracking-[0.22em] text-hk-accent">{c.label}</p>
                                    <p class="mt-2 text-sm leading-relaxed text-white/90">{c.back}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // 手機 / 觸控裝置：輕觸卡片翻面；桌面維持純 hover 翻卡，兩者互不影響。
    var isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;
    if (isTouch) {
        document.querySelectorAll('.flip-card-inner').forEach(function (card) {
            card.setAttribute('role', 'button');
            card.setAttribute('tabindex', '0');
            card.setAttribute('aria-pressed', 'false');
            var toggle = function () {
                var flipped = card.classList.toggle('is-flipped');
                card.setAttribute('aria-pressed', flipped ? 'true' : 'false');
            };
            card.addEventListener('click', toggle);
            card.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggle();
                }
            });
        });
    }
</script>

<style is:global>
    .flip-card-inner.is-flipped {
        transform: rotateY(180deg) !important;
    }
</style>
