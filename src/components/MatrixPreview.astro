---
// src/components/MatrixPreview.astro
const isEn = Astro.currentLocale === 'en';
const projectsUrl = isEn ? '/en/projects' : '/projects';

const t = isEn
  ? {
      h2: 'System matrix preview',
      sub: 'Core architecture modules running and testing right now',
      cardA: 'NLM Lab',
      cardADesc: '100% code-controlled AI automation content pipeline.',
      phase: 'Phase 1 live',
      cardB: 'Cross-border Trade AI Engine',
      cardBDesc: 'European-standard design + Chinese manufacturing, AI-accelerated supply chain.',
      testing: 'Testing',
      cardC: 'Tools & Inner Practice',
      cardCDesc: 'Google Workspace migration & bio-efficiency SOPs.',
      stable: 'Stable iteration',
    }
  : {
      h2: '子系统矩阵预览',
      sub: '目前正在运行与测试的底层架构模块',
      cardA: 'NLM-新店子实验室',
      cardADesc: '100% 代码掌控的 AI 自动化内容流水线。',
      phase: 'Phase 1 运行中',
      cardB: '跨境贸易 AI 引擎',
      cardBDesc: '欧标设计 + 中国制造，AI 提速供应链管理。',
      testing: '测试中',
      cardC: '工具与内在修炼',
      cardCDesc: 'Google Workspace 迁移与生物效率 SOP。',
      stable: '稳定迭代',
    };
---

<!-- 商业/逻辑用途: 展示当前正在运行的核心子系统矩阵，引导用户进入 Projects 页面查看深层内容 -->
<section id="matrix-preview" class="py-20 px-6 max-w-6xl mx-auto">
    <div class="mb-10 text-center md:text-left">
        <h2 class="text-3xl font-black text-hk-primary tracking-tight">
            {t.h2} <span class="text-hk-accent font-mono text-xl opacity-70">/ MATRIX</span>
        </h2>
        <p class="text-stone-500 mt-2 font-medium">{t.sub}</p>
    </div>

    <!-- Bento Grid (便当盒网格) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Card A (占据 2 列宽度) -->
        <a href={projectsUrl} class="md:col-span-2 group relative block bg-stone-900 rounded-2xl p-8 overflow-hidden border border-stone-800 hover:border-hk-accent/50 transition-all duration-300 hover:shadow-[0_10px_30px_rgba(217,119,87,0.15)] hover:-translate-y-1">
            <!-- 装饰背景 -->
            <div class="absolute inset-0 bg-gradient-to-br from-hk-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="space-y-3 flex-1">
                    <h3 class="text-2xl font-bold text-white font-mono tracking-wide flex items-center gap-3">
                        <i class="fas fa-microchip text-hk-accent"></i>
                        {t.cardA}
                    </h3>
                    <p class="text-stone-400 text-lg leading-relaxed">
                        {t.cardADesc}
                    </p>
                </div>
                <div class="flex-shrink-0">
                    <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/20 text-green-400 font-mono text-sm rounded-full">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                        </span>
                        {t.phase}
                    </span>
                </div>
            </div>

            <div class="absolute bottom-4 right-6 opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0 transition-all duration-300">
                <i class="fas fa-arrow-right text-hk-accent text-xl"></i>
            </div>
        </a>

        <!-- Card B -->
        <a href={projectsUrl} class="group relative block bg-[#Fdfbf7] rounded-2xl p-8 overflow-hidden border-2 border-stone-200 hover:border-amber-400/50 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold text-stone-900 font-mono">{t.cardB}</h3>
                    <i class="fas fa-globe-asia text-stone-300 text-2xl group-hover:text-amber-500 transition-colors"></i>
                </div>
                <p class="text-stone-600 leading-relaxed min-h-[3rem]">
                    {t.cardBDesc}
                </p>
                <div class="pt-4 border-t border-stone-200">
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-100 text-amber-700 font-mono text-xs font-bold rounded-full">
                        🟡 {t.testing}
                    </span>
                </div>
            </div>
        </a>

        <!-- Card C -->
        <a href={projectsUrl} class="group relative block bg-[#Fdfbf7] rounded-2xl p-8 overflow-hidden border-2 border-stone-200 hover:border-hk-accent/50 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold text-stone-900 font-mono">{t.cardC}</h3>
                    <i class="fas fa-yin-yang text-stone-300 text-2xl group-hover:text-hk-accent transition-colors"></i>
                </div>
                <p class="text-stone-600 leading-relaxed min-h-[3rem]">
                    {t.cardCDesc}
                </p>
                <div class="pt-4 border-t border-stone-200">
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-100 text-green-700 font-mono text-xs font-bold rounded-full">
                        🟢 {t.stable}
                    </span>
                </div>
            </div>
        </a>

    </div>
</section>
