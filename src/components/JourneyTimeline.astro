---
const isEn = Astro.currentLocale === 'en';

const zhPhases = [
    {
        id: "phase-childhood",
        title: "儿童与少年阶段",
        subtitle: "屋邨里的野孩子",
        yearRange: "1988 - 2000",
        milestones: [
            { id: "stage-child-1", age: "10岁", year: "1998", title: "深水埗的街头智慧", desc: "在屋邨长大，没有丰厚的资源，但学会了如何在复杂的环境中生存。街头的游戏规则，成为我最早的商业启蒙。", impact: "培养了敏锐的观察力与不服输的韧性。", image: "/hero-life.jpg", align: "left" },
            { id: "stage-child-2", age: "15岁", year: "2003", title: "男校的丛林法则", desc: "进入竞争激烈的男校，在学业与人际关系中摸爬滚打。学会了如何在一群强者中找到自己的定位与发言权。", impact: "理解了「实力才是硬道理」的残酷现实。", image: "/hero-main.jpg", align: "right" }
        ]
    },
    { id: "phase-youth", title: "青年与探索阶段", subtitle: "第一份工与社会大学", yearRange: "2005 - 2012", milestones: [
        { id: "stage-youth-1", age: "22岁", year: "2010", title: "社会大学的第一课", desc: "踏入职场，从最基层的职位开始。在现实的磨练中，学会了察言观色与向上管理，提早看清商业社会的底层逻辑。", impact: "种下了「不被环境定义」的种子，锻炼出极强的执行力。", image: "/hero-work.jpg", align: "left" }
    ]},
    { id: "phase-adult", title: "壮年与跨国实战", subtitle: "东南亚拓荒与降维打击", yearRange: "2014 - 2019", milestones: [
        { id: "stage-adult-1", age: "26岁", year: "2014", title: "跨国制造业：东南亚拓荒", desc: "被派往星马泰印尼，面对截然不同的文化与供应链挑战。从工厂现场到区域策略，见证了实体经济的残酷与机遇。", impact: "建立了一套跨文化、跨地域的「降维打击」管理 SOP。", image: "/hero-work.jpg", align: "right" }
    ]},
    { id: "phase-mature", title: "中年与自我重构", subtitle: "父亲、创业者与 AI 系统", yearRange: "2020 - 至今", milestones: [
        { id: "stage-mature-1", age: "30+岁", year: "2020+", title: "身份升级：父亲与创业者", desc: "迎来家庭新成员，同时开启独立顾问生涯。为了爱与信念，决定用 AI 与系统思维重构工作，追求更高的杠杆与自由。", impact: "真正理解「长期主义」与「资产沉淀」的意义。", image: "/hero-main.jpg", align: "left" }
    ]}
];

const enPhases = [
    { id: "phase-childhood", title: "Childhood & Teenage Years", subtitle: "A wild kid from the housing estates", yearRange: "1988 - 2000", milestones: [
        { id: "stage-child-1", age: "10", year: "1998", title: "Street smarts of Sham Shui Po", desc: "Grew up in public housing without abundant resources, but learned how to survive in a complex environment. The rules of the street became my earliest business education.", impact: "Sharpened observation and built unyielding resilience.", image: "/hero-life.jpg", align: "left" },
        { id: "stage-child-2", age: "15", year: "2003", title: "Jungle rules of an all-boys school", desc: "Entered a fiercely competitive all-boys school, fighting through academics and relationships. Learned how to find my place and my voice among the strong.", impact: "Understood the harsh truth that strength is the only currency.", image: "/hero-main.jpg", align: "right" }
    ]},
    { id: "phase-youth", title: "Youth & Exploration", subtitle: "First job & the school of life", yearRange: "2005 - 2012", milestones: [
        { id: "stage-youth-1", age: "22", year: "2010", title: "First lesson from the school of life", desc: "Entered the workforce from the most junior position. Through real-world grind, learned to read the room and manage upward, seeing the underlying logic of business early.", impact: "Planted the seed of 'never be defined by your environment' and built relentless execution.", image: "/hero-work.jpg", align: "left" }
    ]},
    { id: "phase-adult", title: "Prime Years & Cross-border Battles", subtitle: "The SEA frontier & outmaneuvering", yearRange: "2014 - 2019", milestones: [
        { id: "stage-adult-1", age: "26", year: "2014", title: "Cross-border manufacturing: the SEA frontier", desc: "Posted to Singapore, Malaysia, Thailand and Indonesia, facing radically different cultures and supply chains. From the factory floor to regional strategy, witnessed the brutality and opportunity of the real economy.", impact: "Built a cross-cultural, cross-region 'outmaneuver' management SOP.", image: "/hero-work.jpg", align: "right" }
    ]},
    { id: "phase-mature", title: "Mid-life & Reinvention", subtitle: "Father, founder & AI systems", yearRange: "2020 - present", milestones: [
        { id: "stage-mature-1", age: "30+", year: "2020+", title: "Level up: father & founder", desc: "Welcomed a new family member while launching an independent consulting practice. For love and conviction, rebuilt my work with AI and systems thinking, chasing greater leverage and freedom.", impact: "Truly understood 'long-termism' and 'asset accumulation'.", image: "/hero-main.jpg", align: "left" }
    ]}
];

const phases = isEn ? enPhases : zhPhases;

const t = isEn
  ? {
      eyebrow: 'THE JOURNEY',
      h2: 'Level-up roadmap',
      desc: 'Each stage is a breakthrough and a rebirth. Click to expand different chapters of my life, and explore the "gear" and "insights" I gained at each milestone.',
      gained: 'Gained insight / gear:',
    }
  : {
      eyebrow: 'THE JOURNEY',
      h2: '打怪升级路线图',
      desc: '每一个阶段都是一次破局与重生。点击展开不同的人生篇章，滑动查看我在各个 Milestone 获得的「装备」与「认知」。',
      gained: '获得认知/装备：',
    };
---

<section id="journey-timeline" class="py-24 bg-stone-50 relative border-t border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">

        <div class="text-center mb-16">
            <p class="text-xs font-bold tracking-[0.28em] text-amber-600 mb-3">{t.eyebrow}</p>
            <h2 class="text-3xl md:text-4xl font-black text-stone-900">{t.h2}</h2>
            <p class="text-stone-500 mt-4 max-w-xl mx-auto">{t.desc}</p>
        </div>

        <div class="space-y-6">
            {phases.map((phase, phaseIndex) => (
                <div class="border-2 border-stone-200 rounded-2xl bg-white transition-all duration-300 hover:border-amber-300 phase-accordion" data-phase-id={phase.id}>
                    <!-- Accordion Header -->
                    <button class="w-full px-6 py-5 flex items-center justify-between bg-white hover:bg-stone-50 transition-colors accordion-btn rounded-t-[14px]">
                        <div class="flex flex-col sm:flex-row sm:items-center text-left gap-2 sm:gap-6">
                            <div class="font-mono text-amber-600 font-bold text-lg sm:w-32">{phase.yearRange}</div>
                            <div>
                                <h3 class="text-xl sm:text-2xl font-black text-stone-900">{phase.title}</h3>
                                <p class="text-sm text-stone-500 font-medium">{phase.subtitle}</p>
                            </div>
                        </div>
                        <div class="text-stone-400 transition-transform duration-300 transform accordion-icon">
                            <i class="fas fa-chevron-down text-xl"></i>
                        </div>
                    </button>

                    <!-- Accordion Content (Timeline) -->
                    <div class="accordion-content hidden border-t border-stone-100 bg-stone-50/50 px-4 sm:px-8 py-12 relative rounded-b-[14px]">
                        <!-- Central Line -->
                        <div class="absolute left-8 md:left-1/2 top-12 bottom-12 w-0.5 bg-amber-200/60 transform md:-translate-x-1/2"></div>

                        <div class="space-y-16 md:space-y-32">
                            {phase.milestones.map((item) => (
                                <div class={`relative flex flex-col md:flex-row items-start md:items-center group ${item.align === 'right' ? 'md:flex-row-reverse' : ''}`}>

                                    <!-- Timeline Node (Dot) -->
                                    <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full bg-amber-500 border-4 border-white transform -translate-x-[7px] md:-translate-x-1/2 mt-8 md:mt-0 z-10 shadow-sm transition-transform duration-300 group-hover:scale-150 group-hover:bg-amber-600"></div>

                                    <!-- Content Card (Text) -->
                                    <div class={`w-full md:w-1/2 pl-16 pr-0 md:px-16 ${item.align === 'right' ? 'md:text-right' : 'md:text-left'}`}>
                                        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm transition-all duration-500 group-hover:shadow-xl group-hover:border-amber-300 relative z-20">

                                            <!-- Age & Year Badge -->
                                            <div class={`flex items-center gap-3 mb-4 ${item.align === 'right' ? 'md:justify-end' : 'md:justify-start'}`}>
                                                <span class="px-3 py-1 bg-stone-900 text-white text-xs font-mono font-bold rounded-md">{item.age}</span>
                                                <span class="text-stone-400 font-mono text-sm">{item.year}</span>
                                            </div>

                                            <h4 class="text-xl sm:text-2xl font-bold text-stone-900 mb-3">{item.title}</h4>
                                            <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6">{item.desc}</p>

                                            <div class={`bg-amber-50/80 rounded-lg p-4 border border-amber-100/50 ${item.align === 'right' ? 'md:text-right' : 'md:text-left'}`}>
                                                <p class="text-xs text-amber-800 font-bold mb-2"><i class="fas fa-bolt mr-1"></i> {t.gained}</p>
                                                <p class="text-sm text-amber-700 leading-relaxed font-medium">{item.impact}</p>
                                            </div>

                                            <div class="mt-5 md:hidden">
                                                <div class="w-full max-w-xs bg-white p-2 pb-8 rounded-sm border border-stone-200 shadow-md">
                                                    <img src={item.image} alt={item.title} class="w-full h-44 object-cover" />
                                                    <div class="text-center mt-2">
                                                        <span class="font-mono text-xs text-stone-500 font-medium">{item.year} Archive</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hover Image Reveal (Polaroid Style) - Fixed Alignment -->
                                    <div class={`hidden md:block absolute top-1/2 -translate-y-1/2 w-72 h-80 z-10 opacity-80 transition-all duration-700 ease-out pointer-events-none group-hover:opacity-100 group-hover:z-30
                                        ${item.align === 'left'
                                            ? 'right-[5%] group-hover:right-[8%] rotate-6 group-hover:rotate-3'
                                            : 'left-[5%] group-hover:left-[8%] -rotate-6 group-hover:-rotate-3'}
                                    `}>
                                        <div class="w-full h-full bg-white p-3 pb-12 shadow-2xl rounded-sm border border-stone-200">
                                            <img src={item.image} alt={item.title} class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" />
                                            <div class="absolute bottom-4 left-0 w-full text-center">
                                                <span class="font-mono text-xs text-stone-500 font-medium">{item.year} Archive</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const accordions = document.querySelectorAll('.phase-accordion');

        accordions.forEach(accordion => {
            const btn = accordion.querySelector('.accordion-btn');
            const content = accordion.querySelector('.accordion-content');
            const icon = accordion.querySelector('.accordion-icon');

            if (btn && content && icon) {
                btn.addEventListener('click', () => {
                    const isHidden = content.classList.contains('hidden');

                    // Close all others (optional: remove if you want multiple open at once)
                    accordions.forEach(acc => {
                        const c = acc.querySelector('.accordion-content');
                        const i = acc.querySelector('.accordion-icon');
                        if (c && i && c !== content) {
                            c.classList.add('hidden');
                            i.classList.remove('rotate-180');
                            acc.classList.remove('border-amber-300');
                        }
                    });

                    // Toggle current
                    if (isHidden) {
                        content.classList.remove('hidden');
                        icon.classList.add('rotate-180');
                        accordion.classList.add('border-amber-300');
                    } else {
                        content.classList.add('hidden');
                        icon.classList.remove('rotate-180');
                        accordion.classList.remove('border-amber-300');
                    }
                });
            }
        });
    });
</script>
