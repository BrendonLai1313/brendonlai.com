---
// R7：文案與資料全部來自 src/data/journey.ts，元件只負責呈現。
// 中英共用同一份結構（isEn 模式），改文案不必碰這裡的邏輯。
import { journeyPhases, journeyCopy } from '../data/journey';

const isEn = Astro.currentLocale === 'en';
const lang = isEn ? 'en' : 'zh';

const phases = journeyPhases[lang];
const t = journeyCopy[lang];
---

<section id="journey-timeline" class="py-24 bg-stone-50 relative border-t border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">

        <div class="text-center mb-16">
            <p class="text-xs font-bold tracking-[0.28em] text-amber-600 mb-3">{t.eyebrow}</p>
            <h2 class="text-3xl md:text-4xl font-black text-stone-900">{t.h2}</h2>
            <p class="text-stone-500 mt-4 max-w-xl mx-auto">{t.desc}</p>
        </div>

        <div class="space-y-6">
            {phases.map((phase, phaseIndex) => (
                <div class="border-2 border-stone-200 rounded-2xl bg-white transition-all duration-300 hover:border-amber-300 phase-accordion" data-phase-id={phase.id}>
                    <!-- Accordion Header -->
                    <button class="w-full px-6 py-5 flex items-center justify-between bg-white hover:bg-stone-50 transition-colors accordion-btn rounded-t-[14px]">
                        <div class="flex flex-col sm:flex-row sm:items-center text-left gap-2 sm:gap-6">
                            <div class="font-mono text-amber-600 font-bold text-lg sm:w-32">{phase.yearRange}</div>
                            <div>
                                <h3 class="text-xl sm:text-2xl font-black text-stone-900">{phase.title}</h3>
                                <p class="text-sm text-stone-500 font-medium">{phase.subtitle}</p>
                            </div>
                        </div>
                        <div class="text-stone-400 transition-transform duration-300 transform accordion-icon">
                            <i class="fas fa-chevron-down text-xl"></i>
                        </div>
                    </button>

                    <!-- Accordion Content (Timeline) -->
                    <div class="accordion-content hidden border-t border-stone-100 bg-stone-50/50 px-4 sm:px-8 py-12 relative rounded-b-[14px]">
                        <!-- Central Line -->
                        <div class="absolute left-8 md:left-1/2 top-12 bottom-12 w-0.5 bg-amber-200/60 transform md:-translate-x-1/2"></div>

                        <div class="space-y-16 md:space-y-32">
                            {phase.milestones.map((item) => (
                                <div class={`relative flex flex-col md:flex-row items-start md:items-center group ${item.align === 'right' ? 'md:flex-row-reverse' : ''}`}>

                                    <!-- Timeline Node (Dot) -->
                                    <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full bg-amber-500 border-4 border-white transform -translate-x-[7px] md:-translate-x-1/2 mt-8 md:mt-0 z-10 shadow-sm transition-transform duration-300 group-hover:scale-150 group-hover:bg-amber-600"></div>

                                    <!-- Content Card (Text) -->
                                    <div class={`w-full md:w-1/2 pl-16 pr-0 md:px-16 ${item.align === 'right' ? 'md:text-right' : 'md:text-left'}`}>
                                        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm transition-all duration-500 group-hover:shadow-xl group-hover:border-amber-300 relative z-20">

                                            <!-- Age & Year Badge -->
                                            <div class={`flex items-center gap-3 mb-4 ${item.align === 'right' ? 'md:justify-end' : 'md:justify-start'}`}>
                                                <span class="px-3 py-1 bg-stone-900 text-white text-xs font-mono font-bold rounded-md">{item.age}</span>
                                                <span class="text-stone-400 font-mono text-sm">{item.year}</span>
                                            </div>

                                            <h4 class="text-xl sm:text-2xl font-bold text-stone-900 mb-3">{item.title}</h4>
                                            <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6">{item.desc}</p>

                                            <div class={`bg-amber-50/80 rounded-lg p-4 border border-amber-100/50 ${item.align === 'right' ? 'md:text-right' : 'md:text-left'}`}>
                                                <p class="text-xs text-amber-800 font-bold mb-2"><i class="fas fa-bolt mr-1"></i> {t.gained}</p>
                                                <p class="text-sm text-amber-700 leading-relaxed font-medium">{item.impact}</p>
                                            </div>

                                            {item.image && (
                                            <div class="mt-5 md:hidden">
                                                <div class="w-full max-w-xs bg-white p-2 pb-8 rounded-sm border border-stone-200 shadow-md">
                                                    <img src={item.image} alt={item.title} class="w-full h-44 object-cover" />
                                                    <div class="text-center mt-2">
                                                        <span class="font-mono text-xs text-stone-500 font-medium">{item.imageLabel ?? item.year} {t.archive}</span>
                                                    </div>
                                                </div>
                                            </div>
                                            )}
                                        </div>
                                    </div>

                                    <!-- Hover Image Reveal (Polaroid Style) - 只有真实对应年份的照片才显示（image 留空 = 不显示） -->
                                    {item.image && (
                                    <div class={`hidden md:block absolute top-1/2 -translate-y-1/2 w-72 h-80 z-10 opacity-80 transition-all duration-700 ease-out pointer-events-none group-hover:opacity-100 group-hover:z-30
                                        ${item.align === 'left'
                                            ? 'right-[5%] group-hover:right-[8%] rotate-6 group-hover:rotate-3'
                                            : 'left-[5%] group-hover:left-[8%] -rotate-6 group-hover:-rotate-3'}
                                    `}>
                                        <div class="w-full h-full bg-white p-3 pb-12 shadow-2xl rounded-sm border border-stone-200">
                                            <img src={item.image} alt={item.title} class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" />
                                            <div class="absolute bottom-4 left-0 w-full text-center">
                                                <span class="font-mono text-xs text-stone-500 font-medium">{item.imageLabel ?? item.year} {t.archive}</span>
                                            </div>
                                        </div>
                                    </div>
                                    )}

                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const accordions = document.querySelectorAll('.phase-accordion');

        accordions.forEach(accordion => {
            const btn = accordion.querySelector('.accordion-btn');
            const content = accordion.querySelector('.accordion-content');
            const icon = accordion.querySelector('.accordion-icon');

            if (btn && content && icon) {
                btn.addEventListener('click', () => {
                    const isHidden = content.classList.contains('hidden');

                    // Close all others (optional: remove if you want multiple open at once)
                    accordions.forEach(acc => {
                        const c = acc.querySelector('.accordion-content');
                        const i = acc.querySelector('.accordion-icon');
                        if (c && i && c !== content) {
                            c.classList.add('hidden');
                            i.classList.remove('rotate-180');
                            acc.classList.remove('border-amber-300');
                        }
                    });

                    // Toggle current
                    if (isHidden) {
                        content.classList.remove('hidden');
                        icon.classList.add('rotate-180');
                        accordion.classList.add('border-amber-300');
                    } else {
                        content.classList.add('hidden');
                        icon.classList.remove('rotate-180');
                        accordion.classList.remove('border-amber-300');
                    }
                });
            }
        });
    });
</script>
