---
// /projects 的「复古档案卡」视觉外壳（改版路线图第 3 步抽出）
// -----------------------------------------------------------------------------
// 资料来自 src/data/projects.ts。左边「水面之上」= 公开成果；
// 右边「水面之下」= 锁定资源 + 解锁 CTA（走 FORMS.resourceRequest，空则退回 #conversion）。
// 色彩 class 必须写成完整字串（Tailwind v4 静态扫描），不要用字串拼接。
// -----------------------------------------------------------------------------
import type { CaseFileData, CaseTheme } from '../data/projects';
import { FORMS } from '../data/site';

interface Props {
  data: CaseFileData;
}
const { data } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'zh';
const isEn = lang === 'en';

const formHref = FORMS.resourceRequest || (isEn ? '/en/#conversion' : '/#conversion');
const formExternal = Boolean(FORMS.resourceRequest);

const THEMES: Record<CaseTheme, { header: string; subtitle: string; lock: string; button: string }> = {
  amber: {
    header: 'text-amber-500',
    subtitle: 'text-amber-600',
    lock: 'text-amber-500',
    button:
      'bg-amber-600 hover:bg-amber-700 shadow-[0_0_20px_rgba(214,158,46,0.4)] hover:shadow-[0_0_30px_rgba(214,158,46,0.6)]',
  },
  green: {
    header: 'text-green-400',
    subtitle: 'text-green-600',
    lock: 'text-green-400',
    button:
      'bg-green-600 hover:bg-green-700 shadow-[0_0_20px_rgba(72,187,120,0.4)] hover:shadow-[0_0_30px_rgba(72,187,120,0.6)]',
  },
};
const th = THEMES[data.theme];

const LOG_ICON = {
  testing: 'fas fa-spinner fa-spin text-amber-500 mt-1',
  done: 'fas fa-check text-green-500 mt-1',
};

const t = isEn
  ? {
      pain: 'Business pain & ROI',
      stack: 'Core Tech Stack',
      log: 'Build in Public progress log',
      locked: 'Hardcore resources below the surface are locked',
    }
  : {
      pain: '商业痛点与 ROI 预期',
      stack: '核心 Tech Stack',
      log: 'Build in Public 进度日志',
      locked: '水面之下的硬核资源已锁定',
    };
---

<article class="bg-white rounded-xl border-2 border-stone-300 shadow-[8px_8px_0_rgba(41,37,36,1)] overflow-hidden transition-transform hover:-translate-y-1">
  <div class="bg-stone-800 text-stone-300 px-6 py-3 flex items-center justify-between border-b-2 border-stone-800">
    <div class="flex items-center gap-3 font-mono text-sm font-bold tracking-widest">
      <i class={`fas ${data.headerIcon} ${th.header}`}></i>
      FILE_ID: {data.fileId}
    </div>
    <div class="flex gap-2">
      <span class="w-3 h-3 rounded-full bg-red-500"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500"></span>
      <span class="w-3 h-3 rounded-full bg-green-500"></span>
    </div>
  </div>

  <div class="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- 水面之上 -->
    <div class="space-y-6">
      <div>
        <h2 class="text-3xl font-black text-stone-900 mb-2">{data.title[lang]}</h2>
        <p class={`${th.subtitle} font-bold tracking-wider text-sm uppercase`}>{data.subtitle[lang]}</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-bold text-stone-900 border-l-4 border-stone-300 pl-3">{t.pain}</h3>
        <p class="text-stone-600 leading-relaxed text-sm">
          <strong>Why:</strong> {data.why[lang]}<br/>
          <strong>What (ROI):</strong> {data.what[lang]}
        </p>
      </div>
      <div class="space-y-2">
        <h3 class="font-bold text-stone-900 border-l-4 border-stone-300 pl-3">{t.stack}</h3>
        <div class="flex flex-wrap gap-2 mt-2">
          {data.stack[lang].map((s) => (
            <span class="px-2 py-1 bg-stone-100 text-stone-700 text-xs font-mono rounded">{s}</span>
          ))}
        </div>
      </div>
      <div class="bg-stone-50 p-4 rounded-lg border border-stone-200">
        <h3 class="font-bold text-stone-900 mb-2 flex items-center gap-2">
          <i class="fas fa-terminal text-stone-500"></i> {t.log}
        </h3>
        <ul class="space-y-3 text-sm font-mono text-stone-600">
          {data.log.map((item) => (
            <li class="flex items-start gap-2">
              <i class={LOG_ICON[item.status]}></i>
              <span>{item.text[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 水面之下 -->
    <div class="relative bg-stone-900 rounded-xl p-8 flex flex-col justify-center items-center text-center overflow-hidden border-2 border-stone-800">
      <div class="absolute -bottom-10 opacity-10 w-full flex justify-center pointer-events-none">
        <i class={`fas ${data.bgIcon} text-9xl text-white`}></i>
      </div>
      <div class="relative z-10 space-y-6 w-full">
        <div class="w-16 h-16 bg-stone-800 rounded-full flex items-center justify-center mx-auto border border-stone-700 shadow-inner">
          <i class={`fas fa-lock text-2xl ${th.lock}`}></i>
        </div>
        <div>
          <h3 class="text-xl font-bold text-white mb-2">RESTRICTED ACCESS</h3>
          <p class="text-stone-400 text-sm">{t.locked}</p>
        </div>
        <a
          href={formHref}
          target={formExternal ? '_blank' : undefined}
          rel={formExternal ? 'noopener noreferrer' : undefined}
          class={`group relative w-full flex items-center justify-center gap-3 px-6 py-4 ${th.button} text-white font-bold font-mono rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-0.5`}
        >
          <i class="fas fa-key group-hover:rotate-90 transition-transform duration-300"></i>
          <span>{data.cta[lang]}</span>
        </a>
        <p class="text-xs text-stone-500 mt-4 font-mono leading-relaxed">
          <i class="fas fa-shield-alt opacity-70"></i> {data.note[lang][0]}<br/>{data.note[lang][1]}
        </p>
      </div>
    </div>
  </div>
</article>
