---
// /projects 的「复古档案卡」（改版路线图第 3 步）
// -----------------------------------------------------------------------------
// 资料来自 src/data/projects.ts。
// 左边「水面之上」= 问题 → 做法 → 结语 → 顶替的岗位（问题才是主角）。
// 右边 = 这个实证唯一的出口（取代旧版「RESTRICTED ACCESS 解锁资源」）。
// 色彩 class 必须写成完整字串（Tailwind v4 静态扫描），不要用字串拼接。
// -----------------------------------------------------------------------------
import type { CaseFileData, CaseTheme } from '../data/projects';

interface Props {
  data: CaseFileData;
}
const { data } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'zh';
const isEn = lang === 'en';

const THEMES: Record<CaseTheme, { header: string; accent: string; num: string; button: string }> = {
  amber: {
    header: 'text-amber-500',
    accent: 'text-amber-600',
    num: 'bg-amber-100 text-amber-700',
    button:
      'bg-amber-600 hover:bg-amber-700 shadow-[0_0_20px_rgba(214,158,46,0.4)] hover:shadow-[0_0_30px_rgba(214,158,46,0.6)]',
  },
  green: {
    header: 'text-green-400',
    accent: 'text-green-600',
    num: 'bg-green-100 text-green-700',
    button:
      'bg-green-600 hover:bg-green-700 shadow-[0_0_20px_rgba(72,187,120,0.4)] hover:shadow-[0_0_30px_rgba(72,187,120,0.6)]',
  },
  sky: {
    header: 'text-sky-400',
    accent: 'text-sky-600',
    num: 'bg-sky-100 text-sky-700',
    button:
      'bg-sky-600 hover:bg-sky-700 shadow-[0_0_20px_rgba(14,165,233,0.4)] hover:shadow-[0_0_30px_rgba(14,165,233,0.6)]',
  },
};
const th = THEMES[data.theme];

const LOG_ICON = {
  ongoing: 'fas fa-spinner fa-spin text-amber-500 mt-1',
  done: 'fas fa-check text-green-500 mt-1',
};
const NUM = ['①', '②', '③', '④', '⑤'];

const t = isEn
  ? {
      question: 'The problem',
      how: 'How I did it with AI',
      roles: 'Roles covered',
      log: 'Build in Public log',
      exitEyebrow: 'EXIT',
      exitTitle: 'Where this proof leads',
    }
  : {
      question: '问题',
      how: '我怎样用 AI 做',
      roles: '顶替的岗位',
      log: 'Build in Public 进度日志',
      exitEyebrow: 'EXIT',
      exitTitle: '这个实证的出口',
    };
---

<article
  id={data.id}
  class="scroll-mt-28 bg-white rounded-xl border-2 border-stone-300 shadow-[8px_8px_0_rgba(41,37,36,1)] overflow-hidden transition-transform hover:-translate-y-1"
>
  <div class="bg-stone-800 text-stone-300 px-6 py-3 flex items-center justify-between border-b-2 border-stone-800">
    <div class="flex items-center gap-3 font-mono text-sm font-bold tracking-widest min-w-0">
      <i class={`fas ${data.headerIcon} ${th.header}`}></i>
      <span class="truncate">FILE_ID: {data.fileId}</span>
    </div>
    <div class="flex gap-2 shrink-0">
      <span class="w-3 h-3 rounded-full bg-red-500"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500"></span>
      <span class="w-3 h-3 rounded-full bg-green-500"></span>
    </div>
  </div>

  <div class="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-8">
    <!-- 水面之上：问题 → 做法 → 结语 -->
    <div class="space-y-6">
      <div>
        <p class={`${th.accent} font-bold tracking-wider text-sm mb-2`}>{data.tag[lang]}</p>
        <h2 class="text-2xl md:text-3xl font-black text-stone-900 leading-snug">{data.title[lang]}</h2>
      </div>

      <div class="space-y-2">
        <h3 class="font-bold text-stone-900 border-l-4 border-stone-300 pl-3">{t.question}</h3>
        <p class="text-stone-700 leading-relaxed font-medium">{data.question[lang]}</p>
      </div>

      <div class="space-y-3">
        {data.intro.map((p) => <p class="text-stone-600 leading-relaxed text-sm md:text-base">{p[lang]}</p>)}
      </div>

      <div class="space-y-3">
        <h3 class="font-bold text-stone-900 border-l-4 border-stone-300 pl-3">{t.how}</h3>
        <ol class="space-y-4">
          {data.steps.map((s, i) => (
            <li class="flex gap-3">
              <span class={`shrink-0 w-7 h-7 rounded-md ${th.num} font-bold flex items-center justify-center text-sm`}>
                {NUM[i]}
              </span>
              <div>
                <p class="font-bold text-stone-900">{s.title[lang]}</p>
                <p class="text-stone-600 leading-relaxed text-sm mt-1">{s.body[lang]}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <blockquote class="border-l-4 border-hk-accent bg-stone-50 rounded-r-lg px-4 py-3 text-stone-800 font-semibold leading-relaxed">
        {data.closing[lang]}
      </blockquote>

      {data.note && <p class="text-xs text-stone-400 leading-relaxed">* {data.note[lang]}</p>}

      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-stone-400 mb-2">{t.roles}</p>
        <ul class="flex flex-wrap gap-2">
          {data.roles[lang].map((r) => (
            <li class="px-2 py-1 bg-stone-100 text-stone-700 text-xs font-mono rounded">{r}</li>
          ))}
        </ul>
      </div>

      {data.log && data.log.length > 0 && (
        <div class="bg-stone-50 p-4 rounded-lg border border-stone-200">
          <h3 class="font-bold text-stone-900 mb-2 flex items-center gap-2">
            <i class="fas fa-terminal text-stone-500"></i> {t.log}
          </h3>
          <ul class="space-y-3 text-sm font-mono text-stone-600">
            {data.log.map((item) => (
              <li class="flex items-start gap-2">
                <i class={LOG_ICON[item.status]}></i>
                <span>{item.text[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- 出口：这个实证唯一通往的地方 -->
    <div class="relative bg-stone-900 rounded-xl p-8 flex flex-col justify-center items-center text-center overflow-hidden border-2 border-stone-800 min-h-[280px] lg:self-start">
      <div class="absolute -bottom-10 opacity-10 w-full flex justify-center pointer-events-none">
        <i class={`fas ${data.bgIcon} text-9xl text-white`}></i>
      </div>
      <div class="relative z-10 space-y-5 w-full">
        <p class="text-xs font-mono font-bold tracking-[0.3em] text-stone-500">{t.exitEyebrow}</p>
        <h3 class="text-xl font-bold text-white">{t.exitTitle}</h3>
        <p class="text-stone-400 text-sm font-mono break-words">{data.exit.brand}</p>
        {data.exit.href && (
          <a
            href={data.exit.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`group relative w-full flex items-center justify-center gap-3 px-6 py-4 ${th.button} text-white font-bold rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-0.5`}
          >
            <span>{data.exit.label[lang]}</span>
            <i class="fas fa-arrow-up-right-from-square text-xs group-hover:translate-x-0.5 transition-transform"></i>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
